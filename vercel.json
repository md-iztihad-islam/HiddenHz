{
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "cd frontend && npm ci && npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 120,
      "excludeFiles": "{frontend,docs,presentation,tools,node_modules}/**"
    }
  },
  "rewrites": [
    { "source": "/api/:path((?!blob-upload$).*)", "destination": "/api/index" }
  ]
}
